{
  "name": "fau-person",
  "version": "3.10.10",
  "description": "Kontakt-Plugin für FAU Webauftritte.",
  "main": "fau-person.php",
  "textdomain": "fau-person",
  "private": true,
  "scripts": {
    "readme": "node scripts/build-readme.js",
    "version:dev": "node scripts/build-version.js dev",
    "version:prod": "node scripts/build-version.js prod",
    "version:release": "node scripts/build-version.js release",
    "dev": "node scripts/build-assets.js dev && npm run version:dev && npm run readme",
    "build": "node scripts/build-assets.js prod && npm run version:prod && npm run readme",
    "prod": "npm run build",
    "release": "node scripts/build-assets.js prod && npm run version:release && npm run readme"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RRZE-Webteam/fau-person",
    "issues": "https://github.com/RRZE-Webteam/fau-person/issues",
    "clone": "git+https://github.com/RRZE-Webteam/fau-person.git"
  },
  "compatibility": {
    "wprequires": "6.7",
    "wptestedup": "7.1",
    "phprequires": "8.2"
  },
  "author": {
    "name": "RRZE-Webteam <webmaster@fau.de> (https://www.rrze.fau.de)",
    "url": "https://www.wp.rrze.fau.de"
  },
  "source": {
    "js": "./src/js/",
    "css": "./src/sass/"
  },
  "target": {
    "js": "./js/",
    "css": "./css/"
  },
  "license": "GNU General Public License v3 or later",
  "licenseurl": "http://www.gnu.org/licenses/gpl-3.0.html",
  "tags": "Plugin, WordPress, FAU-Person, FAU, RRZE",
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-tsdoc": "^0.5.0",
    "sass": "^1.104.0"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  }
}
